# Copy to .env in the directory you run `dincli` from (it reads .env from
# the current working directory only — it does not walk parent dirs).
# See Documentation/setup.md for the full walkthrough.
#
#   cp .env.example .env
#   chmod 600 .env

# --- Wallet -------------------------------------------------------------- #

# Encrypts your private key at rest. Required before `system connect-wallet`.
DIN_WALLET_PASSWORD=

# Private keys, indexed from 0. Used by `connect-wallet --account N` and
# `system` client-spawning flags. Define as many as you need.
ETH_PRIVATE_KEY_0=
# ETH_PRIVATE_KEY_1=

# --- RPC URLs -------------------------------------------------------------- #
# Pattern: [NETWORK]_RPC_URL, uppercase, matching --network / configure-network.
# Only the network you actually use needs to be set.

# Required for devnet (--network sepolia_op_devnet).
SEPOLIA_OP_DEVNET_RPC_URL=

# Optional — local Hardhat node (--network local).
# LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional — only needed for `system bridge-eth` (Ethereum Sepolia L1, to
# bridge ETH onto OP Sepolia). Can also be passed per-invocation via
# --l1-rpc-url instead of setting it here.
# SEPOLIA_L1_RPC_URL=

# --- IPFS ------------------------------------------------------------------ #
# Filebase (recommended) is configured via `dincli system configure-ipfs
# --provider filebase --api-key ...`, not via .env. The two vars below are
# only for the self-hosted-node / custom-endpoint path — see setup.md §7.

# IPFS_API_URL_ADD=
# IPFS_API_URL_RETRIEVE=

# Opt-in: fall back to a public gateway for retrieval if the configured
# provider fails. Set to "true" to use the built-in default gateway, or to
# an explicit https:// gateway URL to use a different one.
# IPFS_PUBLIC_GATEWAY=
