# Compiler files
cache/
out/

# Ignores development broadcast logs. Public-network broadcasts (e.g.
# broadcast/<Script>.s.sol/11155420/ for Optimism Sepolia) are committed on
# purpose as the deploy record next to deployments/<network>.json; they hold
# tx hashes, calldata and addresses, never keys.
/broadcast/*/31337/
/broadcast/*/1337/
/broadcast/**/dry-run/

# Local deployment artifacts (regenerated on every anvil deploy). Public-network
# files (e.g. deployments/sepolia_op_devnet.json) are committed as the record.
deployments/localhost.json
deployments/fair-launch-localhost.json

# Docs
docs/

# Dotenv file
.env

# foundry lib
lib/*
node_modules/*

