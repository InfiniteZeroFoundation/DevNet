# Copy to .env and adjust if your local setup differs from the defaults.
# docker-compose.yml reads these values at container start time.

# RPC endpoint for the local anvil/hardhat chain (chainId 1337).
# On Linux, replace host.docker.internal with the Docker bridge IP: 172.17.0.1
ETHEREUM_RPC=http://host.docker.internal:8545

# Postgres credentials — change before any non-local deployment.
POSTGRES_USER=graph-node
POSTGRES_PASSWORD=din-graph-local
POSTGRES_DB=graph-node
