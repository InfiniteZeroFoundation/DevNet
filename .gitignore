# Bytecode anywhere. The three path-specific rules above predate this and are
# now redundant; left in place to keep this diff small. Needed because
# .github/scripts/ is imported by tests, which was not a pycache site before.
__pycache__/

# build artifacts / local envs picked up while making the tree CI-ready.
# foundry/out, foundry/cache, hardhat/artifacts, hardhat/cache and
# hardhat/typechain-types are already covered by foundry/.gitignore and
# hardhat/.gitignore, so they are deliberately not repeated here.
node_modules/
.pytest_cache/
.ruff_cache/
.venv/
